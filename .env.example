# Copy to .env and fill in real values. Never commit .env.

APP_ENV=development
LOG_LEVEL=INFO

# Local dev default matches compose.override.yaml (db port published on host).
DATABASE_URL=postgresql+asyncpg://tariff:tariff@localhost:5432/tariff

# Set LLM_PROVIDER=fake to use the deterministic fakes (no API key, no network).
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.6-luna
# Model for ingestion and rule compilation (cached work); empty = LLM_MODEL.
LLM_COMPILE_MODEL=
OPENAI_API_KEY=changeme
EMBEDDING_MODEL=text-embedding-3-small
# Must match the vector(n) column created by the first migration.
EMBEDDING_DIMENSIONS=1536
# Leave empty to omit (for models that only accept their default temperature).
LLM_TEMPERATURE=0
# Reasoning models only: minimal | low | medium | high. Empty leaves the model default.
LLM_REASONING_EFFORT=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_MAX_CONCURRENCY=8

AGENT_MAX_TOOL_CALLS=8
AGENT_MAX_REVISIONS=2
AGENT_CRITIC_ON_CACHE_HIT=false
CALCULATION_TIMEOUT_SECONDS=300

RETRIEVAL_TOP_K=8
RETRIEVAL_RRF_K=60

PARSER_VISION_FALLBACK=false
TARIFFS_DIR=./data/tariffs
MAX_UPLOAD_MB=25

# When set, every /v1/* request must send this value in the X-API-Key header.
API_AUTH_KEY=

# Optional Langfuse tracing. Create keys in your Langfuse project before enabling.
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_SAMPLE_RATE=1.0
# When false, traces keep timing/token/model metadata but redact prompts and responses.
LANGFUSE_CAPTURE_CONTENT=false

UVICORN_WORKERS=2
